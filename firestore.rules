rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /push/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /ranking/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /duels/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.a == request.auth.uid;
      allow update: if signedIn() && (request.auth.uid in resource.data.p
                     || (resource.data.b == null && request.resource.data.b == request.auth.uid));
      allow delete: if signedIn() && request.auth.uid == resource.data.a;
    }
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update: if signedIn() && (resource.data.host == request.auth.uid
                     || resource.data.wAt < request.time.toMillis() - 21600000);
      match /players/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
